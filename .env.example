# Primary LLM Provider: "ollama", "openai", "anthropic", "auto", or "none"
LLM_PROVIDER=ollama

# Ollama Base URL & Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_CLASSIFICATION_MODEL=gpt-oss:120b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Default LLM Model
DEFAULT_LLM_MODEL=gpt-oss:120b-cloud

# Embedding Provider Choice: "local" (fast default), "openai", "ollama", or "auto"
EMBEDDING_PROVIDER=local
ACTIVE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Mode Choice: "local" (default persistent storage) or "remote"
CHROMA_MODE=local

# Optional OpenAI API Key (Only if LLM_PROVIDER="openai")
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
