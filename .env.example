# --- Server & Network Ports ---
# Backend REST API & Universal MCP Server Port
PORT=7777
MCP_PORT=7777
API_PORT=7777

# Frontend Web Application Port (Safe port: 8888)
FRONTEND_PORT=8888
VITE_PORT=8888


# --- LLM / AI Chat Companion Settings ---
# Provider Choice: "ollama" (local Ollama), "openai" (OpenAI / AWS Bedrock Mantle / Custom API), or "auto"

LLM_PROVIDER=ollama

# Active Chat Model (e.g. "gpt-oss:120b-cloud", "gemma4:31b-cloud", "gpt-4o-mini")
LLM_MODEL=gpt-oss:120b-cloud

# --- Vector Embedding Settings ---
# Provider Choice: "local" (HuggingFace SentenceTransformer), "ollama", "openai", or "auto"
EMBEDDING_PROVIDER=ollama

# Ollama Embeddings Model Choice:
# - "nomic-embed-text" (768 dimensions - fast & recommended)
# - "bge-m3" (1024 dimensions - multilingual & high precision)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama Server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Chat / Classifier Models
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_CLASSIFICATION_MODEL=gpt-oss:120b-cloud

# --- Local HuggingFace / Fallback Embedding Model ---
# Options: "all-MiniLM-L6-v2" (384 dim), "bge-small-en-v1.5" (512 dim)
FALLBACK_EMBEDDING_MODEL=all-MiniLM-L6-v2
ACTIVE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- OpenAI / Custom LLM API (Optional) ---
OPENAI_API_KEY=your_openai_or_bedrock_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- ChromaDB Storage Settings ---
# Mode Choice: "local" (persistent SQLite/duckdb storage) or "remote" (HttpClient)
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
