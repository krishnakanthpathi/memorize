# OpenAI API Key (Optional: for text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Base URL & Model (Optional: for local Ollama RAG)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Default Embedding Model Choice: "text-embedding-3-small", "nomic-embed-text", or "all-MiniLM-L6-v2"
ACTIVE_EMBEDDING_MODEL=all-MiniLM-L6-v2
