# Embedding Provider Choice: "local" (fast default), "openai", "ollama", or "auto" (fallback chain)
EMBEDDING_PROVIDER=local

# ChromaDB Mode Choice: "local" (default persistent storage) or "remote"
CHROMA_MODE=local

# OpenAI API Key & Base URL (Optional: when EMBEDDING_PROVIDER="openai")
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Base URL & Model (Optional: when EMBEDDING_PROVIDER="ollama")
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Default Embedding Model Choice for Local/OpenAI: "all-MiniLM-L6-v2", "text-embedding-3-small", "nomic-embed-text"
ACTIVE_EMBEDDING_MODEL=all-MiniLM-L6-v2
