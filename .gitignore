# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables
.env
.env.local
.env.*.local

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Vector DB & Local Storage Data (ignore binary vector files, keep folder structure)
data/chroma_db/*
!data/chroma_db/.gitkeep

# Ignore raw uploaded media binaries from Git tracking if large
data/media_store/images/*
!data/media_store/images/.gitkeep
data/media_store/videos/*
!data/media_store/videos/.gitkeep
data/media_store/audio/*
!data/media_store/audio/.gitkeep
data/media_store/documents/*
!data/media_store/documents/.gitkeep

# Temporary / Log files
*.log
*.tmp
